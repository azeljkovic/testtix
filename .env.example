# Copy to `.env` and adjust. `.env` is git-ignored.
# Every value has a default, so `.env` is only needed to override one.

# --- Local infra (docker/compose.yml) ---
# Change a port if it is already taken on your machine (for example by a native Postgres).
POSTGRES_USER=testtix
POSTGRES_PASSWORD=testtix
POSTGRES_DB=testtix
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API (apps/api) ---
# Validated on startup (apps/api/src/config/config.schema.ts); a bad value stops the API with a list of problems.
# NODE_ENV: development | test | production. In production, DATABASE_URL and REDIS_URL must be set.
NODE_ENV=development
# Bind address. Use 0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
DATABASE_URL=postgresql://testtix:testtix@localhost:5432/testtix
REDIS_URL=redis://localhost:6379
# Per-dependency timeout for GET /health/ready, in milliseconds.
HEALTH_CHECK_TIMEOUT_MS=1000

# --- Integration tests (pnpm test:integration) ---
# Unset: the tests start Postgres and Redis with Testcontainers (needs Docker).
# Set: the tests use these instead and DELETE ALL THEIR DATA. The database must be named `test` or end in
# `_test`, and Redis must use a database other than 0.
# TEST_DATABASE_URL=postgresql://testtix:testtix@localhost:5432/testtix_test
# TEST_REDIS_URL=redis://localhost:6379/1
