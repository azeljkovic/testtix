# Copy to `.env` and adjust. `.env` is git-ignored.
# Every value has a default, so `.env` is only needed to override one.

# --- Local infra (docker/compose.yml) ---
# Change a port if it is already taken on your machine (for example by a native Postgres).
POSTGRES_USER=testtix
POSTGRES_PASSWORD=testtix
POSTGRES_DB=testtix
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Fake payment provider (apps/fake-payments), built and run by compose. Host port of its payment page and API.
FAKE_PAYMENTS_PORT=4000
# Bearer key for POST/GET /sessions, and the HMAC secret of its webhook signatures (at least 16 characters each).
# The API reads the same two variables, so set them once here for both.
PAYMENTS_API_KEY=sk_test_testtix_local_only
PAYMENTS_WEBHOOK_SECRET=whsec_testtix_local_only
# Optional tuning of the fake provider, passed to its container (defaults shown):
# FAKE_PAYMENTS_LOG_LEVEL=info
# Minutes a payment page stays payable (1–1440).
# FAKE_PAYMENTS_SESSION_TTL_MINUTES=30
# Wait before the "delayed webhook" test card's webhook, in milliseconds (0–600000).
# FAKE_PAYMENTS_DELAYED_WEBHOOK_MS=10000
# Deliveries per webhook event before giving up (1–20), the first retry's wait (doubling after that, capped at
# 5 minutes) and the per-delivery response timeout, in milliseconds.
# FAKE_PAYMENTS_WEBHOOK_MAX_ATTEMPTS=6
# FAKE_PAYMENTS_WEBHOOK_RETRY_BASE_MS=1000
# FAKE_PAYMENTS_WEBHOOK_TIMEOUT_MS=5000

# --- API (apps/api) ---
# Validated on startup (apps/api/src/config/config.schema.ts); a bad value stops the API with a list of problems.
# NODE_ENV: development | test | production. In production, DATABASE_URL and REDIS_URL must be set.
NODE_ENV=development
# Bind address. Use 0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=3000
# Port of the standalone worker's health checks (`start:worker`, the `worker` container); it binds to HOST too.
WORKER_PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
DATABASE_URL=postgresql://testtix:testtix@localhost:5432/testtix
REDIS_URL=redis://localhost:6379
# Per-dependency timeout for GET /health/ready, in milliseconds.
HEALTH_CHECK_TIMEOUT_MS=1000
# true | false. Enables the test API (/__test/*) and lets it control the server clock. Off: /__test/* answers 404.
TESTTIX_TEST_MODE=true
# Optional, at least 16 characters. When set, test endpoints with a global effect (POST /__test/clock, and
# POST /__test/reset from C1.3) require it in an `X-Test-Key` header. Leave unset locally; set it on shared instances.
# TEST_API_KEY=
# Idle timeout of a login session, in hours (1–8760). Every authenticated request moves the expiry this far ahead.
SESSION_TTL_HOURS=168
# true | false. `Secure` attribute of the session and CSRF cookies. Unset: on when NODE_ENV=production, off otherwise
# (browsers drop Secure cookies on plain-HTTP origins like http://localhost).
# COOKIE_SECURE=
# Where email goes: smtp://[user:password@]host:port, or smtps:// for implicit TLS. Unset: Mailpit at
# smtp://localhost:1025. Required when NODE_ENV=production.
SMTP_URL=smtp://localhost:1025
# `From` header of every email.
MAIL_FROM=TestTix <no-reply@testtix.test>
# Public URL of the web app; links in emails point here. Unset: http://localhost:5173. Required when NODE_ENV=production.
WEB_BASE_URL=http://localhost:5173
# How long an email verification link works, in hours (1–720).
EMAIL_VERIFICATION_TTL_HOURS=24
# true | false. The API process also runs the background job worker. Set false when you run the worker as its own
# process (`pnpm --filter @testtix/api start:worker`), which reads this same file.
WORKER_IN_PROCESS=true
# true | false. Repeatable job that deletes expired holds and frees their tickets. Cleanup only: expired holds count
# as available either way. false also removes a schedule left in Redis by an earlier run.
HOLD_SWEEPER_ENABLED=true
# How often the hold sweeper runs, in milliseconds (100–86400000).
HOLD_SWEEPER_INTERVAL_MS=60000
# Payment provider used by checkout (POST /orders). It also reads PAYMENTS_API_KEY from the infra section above.
# Unset: the fake provider at http://localhost:4000. PAYMENTS_BASE_URL, PAYMENTS_API_KEY and PAYMENTS_WEBHOOK_URL are
# required when NODE_ENV=production.
PAYMENTS_BASE_URL=http://localhost:4000
# Where the provider POSTs payment webhooks: this API's /webhooks/payments as the provider reaches it. Unset:
# http://host.docker.internal:<PORT>/webhooks/payments (the compose provider calling the API on the host).
# PAYMENTS_WEBHOOK_URL=http://host.docker.internal:3000/webhooks/payments
# Timeout of a request to the provider, in milliseconds (100–60000). Checkout answers 503 when it runs out.
PAYMENTS_TIMEOUT_MS=5000
# `retryAfterMs` of an order that is still changing (GET /orders/{id}), in milliseconds (100–60000).
ORDER_POLL_INTERVAL_MS=2000
# Webhook signatures use PAYMENTS_WEBHOOK_SECRET from the infra section above (required when NODE_ENV=production).
# A webhook whose signed timestamp is further than this from the real time (not the test clock) is rejected, in
# seconds (1–3600).
PAYMENTS_WEBHOOK_TOLERANCE_SEC=300
# How long a PROCESSING order (payment reported, or a free order) waits before the job confirms or fails it, in
# milliseconds (0–600000). Raise it to watch "processing" for longer.
JOB_PROCESSING_DELAY_MS=1000
# How often the waiting-room admission job runs, in milliseconds of real time (100–60000). How many customers it lets
# in follows each event's admission rate and the server clock, not this interval.
QUEUE_ADMISSION_INTERVAL_MS=1000
# Longest `retryAfterMs` of a waiting queue entry (GET /queue/{token}), in milliseconds (100–60000).
QUEUE_POLL_INTERVAL_MS=2000
# Proxies in front of the API whose X-Forwarded-For to trust for the client address (rate limits count per address):
# false (default: the connecting address), true (every hop), or comma-separated addresses / CIDR ranges.
TRUST_PROXY=false
# true | false. Rate limits, counted in Redis per client address in fixed windows. Each limit is <requests>/<window>
# with the window in s, m or h (1s–24h). A 429 `rate-limited` carries Retry-After (seconds).
RATE_LIMIT_ENABLED=true
# Every route not in another group (health checks, /metrics and payment webhooks are never limited).
RATE_LIMIT_DEFAULT=600/1m
# POST /auth/login, /auth/register and /auth/verify-email together, on top of the default.
RATE_LIMIT_AUTH=20/1m
# The test API (/__test/*), instead of the default.
RATE_LIMIT_TEST_API=300/1m
# POST /auth/verify-email/resend, per user, on top of the default.
RATE_LIMIT_VERIFICATION_RESEND=3/15m
# Optional, at least 16 characters. Requests with this value in an `X-Load-Test-Key` header skip every rate limit
# (authorised load runs). Unset: the header is ignored.
# LOAD_TEST_KEY=

# --- Containers (`pnpm full:up`, the `full` compose profile) ---
# The app's containers read the API settings above, except those that wire them together (see docker/compose.yml).
# PORT and WEB_PORT are the host ports of the API and the web app there too.
# Number of API containers behind Caddy.
# API_REPLICAS=2
# Run published images instead of building them, e.g. ghcr.io/azeljkovic/testtix and sha-<commit>, main or a version.
# TESTTIX_IMAGE_REGISTRY=testtix
# TESTTIX_IMAGE_TAG=dev

# --- Web dev server (apps/web) ---
# Port of `pnpm --filter @testtix/web dev`, and where it forwards `/api/*` (with the prefix removed).
WEB_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:3000

# --- Integration tests (pnpm test:integration) ---
# Unset: the tests start Postgres, Redis and Mailpit with Testcontainers (needs Docker).
# Set: the tests use these instead and DELETE ALL THEIR DATA. The database must be named `test` or end in
# `_test`, and Redis must use a database other than 0.
# TEST_DATABASE_URL=postgresql://testtix:testtix@localhost:5432/testtix_test
# TEST_REDIS_URL=redis://localhost:6379/1
# Mailpit: set both or neither. Tests don't delete its messages; they search by unique recipient.
# TEST_SMTP_URL=smtp://localhost:1025
# TEST_MAILPIT_URL=http://localhost:8025
# The end-to-end checkout test builds and starts the fake payment provider from its Dockerfile. Set this to use the
# running compose provider instead (faster); it must use the dev PAYMENTS_API_KEY and PAYMENTS_WEBHOOK_SECRET.
# TEST_PAYMENTS_URL=http://localhost:4000
