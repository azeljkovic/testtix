{
  "name": "testtix",
  "version": "0.0.0",
  "private": true,
  "description": "TestTix \u2014 a sample event ticket shop built as a realistic target for software testing practice.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "openapi": "turbo run openapi",
    "openapi:check": "bash scripts/check-openapi.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "infra:up": "docker compose --project-directory . -f docker/compose.yml up -d --wait",
    "infra:check": "bash docker/smoke-test.sh",
    "infra:down": "docker compose --project-directory . -f docker/compose.yml down",
    "infra:reset": "docker compose --project-directory . -f docker/compose.yml down --volumes",
    "db:migrate": "pnpm --filter @testtix/api db:migrate",
    "db:deploy": "pnpm --filter @testtix/api db:deploy",
    "db:reset": "pnpm --filter @testtix/api db:reset",
    "db:seed": "turbo run db:seed"
  },
  "devDependencies": {
    "@testtix/config": "workspace:*",
    "prettier": "3.10.1",
    "turbo": "2.11.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "@swc/core",
      "cpu-features",
      "protobufjs",
      "ssh2"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "openapi-typescript>typescript": "6"
      }
    }
  }
}
