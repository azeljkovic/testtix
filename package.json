{
  "name": "testtix",
  "version": "0.0.0",
  "private": true,
  "description": "TestTix — a sample event ticket shop built as a realistic target for software testing practice.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@testtix/config": "workspace:*",
    "prettier": "3.10.1",
    "turbo": "2.11.11"
  }
}
