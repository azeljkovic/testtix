// TestTix database schema. Conventions:
// - Tables and columns are snake_case in Postgres (`@@map` / `@map`); models stay PascalCase/camelCase.
// - Primary keys are UUIDv7 (time-ordered, generated by Prisma), stored as `uuid`. The seed passes
//   its own deterministic IDs instead (src/seed/seed-id.ts).
// - Timestamps are `timestamptz` and always set by the application from `ClockService`: there are
//   no `now()` defaults or `@updatedAt`, which would read the real time and ignore the test clock.
// - Money is integer cents (`*Cents`), currency USD (`CURRENCY` in @testtix/shared).
// - Enum values match the arrays in @testtix/shared (checked by src/infra/prisma-enums.test.ts).
// - CHECK constraints that Prisma can't express are added by hand at the end of a migration.
// - The connection URL lives in `prisma.config.ts`, not here (Prisma 7).
//
// After changing this file: `pnpm --filter @testtix/api db:migrate --name <change>`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // NodeNext resolution needs explicit `.js` extensions on relative imports.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---------------------------------------------------------------------------------

/// `ROLES` in @testtix/shared.
enum Role {
  CUSTOMER
  ADMIN

  @@map("role")
}

/// `EVENT_CATEGORIES` in @testtix/shared.
enum EventCategory {
  CONCERT
  TALK
  MEETUP

  @@map("event_category")
}

/// `EVENT_STATUSES` in @testtix/shared.
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("event_status")
}

/// `SECTION_TYPES` in @testtix/shared.
enum SectionType {
  SEATED
  GA

  @@map("section_type")
}

/// `INVENTORY_STATUSES` in @testtix/shared.
enum InventoryStatus {
  AVAILABLE
  HELD
  SOLD

  @@map("inventory_status")
}

/// `ORDER_STATUSES` in @testtix/shared.
enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  CONFIRMED
  FAILED
  EXPIRED

  @@map("order_status")
}

/// `PAYMENT_EVENT_OUTCOMES` in @testtix/shared.
enum PaymentEventOutcome {
  APPLIED
  IGNORED
  REFUND_DUE

  @@map("payment_event_outcome")
}

// --- Accounts ------------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased, so the unique index is case-insensitive in practice.
  email           String    @unique
  /// argon2id hash (C1.4).
  passwordHash    String    @map("password_hash")
  name            String
  role            Role      @default(CUSTOMER)
  /// Null until the address is verified (C1.5). Unverified users can't check out.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  verificationToken EmailVerificationToken?
  holds             Hold[]
  orders            Order[]

  @@map("users")
}

/// A signed-in browser (C1.4). The cookie carries a random token; only its SHA-256 is stored.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  /// Sliding: moved forward on use.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// --- Venues --------------------------------------------------------------------------------

/// A user's current email verification link (C1.5). At most one per user: issuing a new link
/// (a resend) replaces the old one, so only the latest email's link works.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  /// SHA-256 of the token in the link. The token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the link is used. Using it again succeeds without changes, until it is replaced.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)
  /// When the current link was issued.
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Venue {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  address   String
  city      String
  /// IANA time zone; event times are shown in the venue's local time.
  timezone  String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  sections Section[]
  events   Event[]

  @@map("venues")
}

/// Part of a venue's layout. `SEATED` sections have seats; `GA` (general admission) sections
/// have a capacity instead (a CHECK constraint enforces exactly one of the two).
model Section {
  id        String      @id @default(uuid(7)) @db.Uuid
  venueId   String      @map("venue_id") @db.Uuid
  name      String
  type      SectionType
  /// GA only: how many people the section holds.
  capacity  Int?
  /// Display order within the venue.
  sortOrder Int         @map("sort_order")

  venue          Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats          Seat[]
  inventoryUnits InventoryUnit[]

  @@unique([venueId, name])
  @@unique([venueId, sortOrder])
  @@map("sections")
}

/// A physical seat in a seated section. Event-specific state lives in `InventoryUnit`.
model Seat {
  id        String @id @default(uuid(7)) @db.Uuid
  sectionId String @map("section_id") @db.Uuid
  /// Row label as printed on the ticket, e.g. "A" or "AA".
  row       String
  /// 0-based position of the row in the section (front first), for sorting and layout.
  rowIndex  Int    @map("row_index")
  /// Seat number within the row, from 1.
  number    Int

  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  inventoryUnits InventoryUnit[]

  @@unique([sectionId, row, number])
  @@unique([sectionId, rowIndex, number])
  @@map("seats")
}

// --- Events and inventory ------------------------------------------------------------------

model Event {
  id                   String        @id @default(uuid(7)) @db.Uuid
  slug                 String        @unique
  title                String
  /// Artist, speaker or host; searched together with the title (C2.2).
  performer            String
  description          String
  category             EventCategory
  status               EventStatus   @default(DRAFT)
  venueId              String        @map("venue_id") @db.Uuid
  startsAt             DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime      @map("ends_at") @db.Timestamptz(3)
  /// When tickets go on sale. A ticket drop (C5.1) opens at this time.
  salesOpenAt          DateTime      @map("sales_open_at") @db.Timestamptz(3)
  /// How long a hold lasts (C3.1).
  holdDurationSec      Int           @default(600) @map("hold_duration_sec")
  /// Most tickets in one hold or order.
  maxTicketsPerOrder   Int           @default(6) @map("max_tickets_per_order")
  // Drop settings (C5.1).
  waitingRoomEnabled   Boolean       @default(false) @map("waiting_room_enabled")
  admissionRatePerSec  Int           @default(10) @map("admission_rate_per_sec")
  admissionTokenTtlSec Int           @default(600) @map("admission_token_ttl_sec")
  createdAt            DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @map("updated_at") @db.Timestamptz(3)

  venue          Venue           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  batches        TicketBatch[]
  inventoryUnits InventoryUnit[]
  holds          Hold[]
  orders         Order[]

  // Public catalogue (C2.2): published events by date, with `id` as the tiebreaker.
  @@index([status, startsAt, id])
  @@index([venueId, startsAt])
  @@map("events")
}

/// Inventory released together at one price (C2.1). Its units can't be sold before `releasesAt`.
model TicketBatch {
  id         String   @id @default(uuid(7)) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  name       String
  priceCents Int      @map("price_cents")
  releasesAt DateTime @map("releases_at") @db.Timestamptz(3)
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inventoryUnits InventoryUnit[]

  @@index([eventId, releasesAt])
  @@map("ticket_batches")
}

/// One sellable ticket for an event: a seat (`seatId` set) or a place in a GA section
/// (`seatId` null). Seated and GA tickets share this model, so holds, expiry, orders and tickets
/// use one code path.
///
/// A unit is `HELD` exactly when it has a hold (CHECK constraint). A hold has expired when
/// `heldUntil` is in the past; such a unit counts as available (evaluated lazily, C3.1).
model InventoryUnit {
  id         String          @id @default(uuid(7)) @db.Uuid
  eventId    String          @map("event_id") @db.Uuid
  sectionId  String          @map("section_id") @db.Uuid
  /// Null for GA.
  seatId     String?         @map("seat_id") @db.Uuid
  batchId    String          @map("batch_id") @db.Uuid
  status     InventoryStatus @default(AVAILABLE)
  priceCents Int             @map("price_cents")
  holdId     String?         @map("hold_id") @db.Uuid
  /// Copy of the hold's `expiresAt`, so a claim is one conditional UPDATE on this table.
  heldUntil  DateTime?       @map("held_until") @db.Timestamptz(3)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  seat       Seat?       @relation(fields: [seatId], references: [id], onDelete: Restrict)
  batch      TicketBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  hold       Hold?       @relation(fields: [holdId], references: [id], onDelete: NoAction)
  orderItems OrderItem[]

  /// A seat is sold at most once per event. GA units (null `seatId`) don't conflict.
  @@unique([eventId, seatId])
  // Seat map and GA claims (`... FOR UPDATE SKIP LOCKED LIMIT n`, C3.1).
  @@index([eventId, sectionId, status])
  @@index([holdId])
  @@index([batchId])
  // Hold sweeper (C3.2).
  @@index([status, heldUntil])
  @@map("inventory_units")
}

/// A customer's temporary claim on inventory units (C3.1). One per user and event: a new hold
/// replaces the old one.
model Hold {
  id        String   @id @default(uuid(7)) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryUnits InventoryUnit[]
  order          Order?

  @@unique([eventId, userId])
  @@index([userId])
  @@index([expiresAt])
  @@map("holds")
}

// --- Orders and tickets --------------------------------------------------------------------

/// Lifecycle: `PENDING_PAYMENT → PROCESSING → CONFIRMED | FAILED | EXPIRED` (C4.2, C4.3).
model Order {
  id               String      @id @default(uuid(7)) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  eventId          String      @map("event_id") @db.Uuid
  status           OrderStatus @default(PENDING_PAYMENT)
  totalCents       Int         @map("total_cents")
  /// An unpaid order expires with its hold.
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(3)
  /// The hold this order checks out (C4.2): one order per hold. Null once the hold is gone
  /// (paid, released, replaced or swept); deleting a hold expires its unpaid order first.
  holdId           String?     @unique @map("hold_id") @db.Uuid
  /// The fake payment provider's session (C4.1). Null until the provider has answered.
  paymentSessionId String?     @unique @map("payment_session_id")
  /// The provider's payment page for `paymentSessionId`.
  paymentUrl       String?     @map("payment_url")
  createdAt        DateTime    @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  hold          Hold?          @relation(fields: [holdId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  paymentEvents PaymentEvent[]

  // "My orders", newest first (C4.2).
  @@index([userId, createdAt, id])
  @@index([status, expiresAt])
  @@map("orders")
}

/// One inventory unit in an order, with the price paid. A unit can appear in several orders
/// over time (e.g. after a failed payment), but only once per order.
model OrderItem {
  id              String @id @default(uuid(7)) @db.Uuid
  orderId         String @map("order_id") @db.Uuid
  inventoryUnitId String @map("inventory_unit_id") @db.Uuid
  priceCents      Int    @map("price_cents")

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id], onDelete: Restrict)
  ticket        Ticket?

  @@unique([orderId, inventoryUnitId])
  @@index([inventoryUnitId])
  @@map("order_items")
}

/// Issued for each item of a confirmed order (C4.4).
model Ticket {
  id          String   @id @default(uuid(7)) @db.Uuid
  orderItemId String   @unique @map("order_item_id") @db.Uuid
  /// Unguessable code encoded in the QR.
  code        String   @unique
  issuedAt    DateTime @map("issued_at") @db.Timestamptz(3)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@map("tickets")
}

/// A webhook received from the payment provider (C4.3). The unique provider event ID makes
/// duplicate deliveries a no-op.
model PaymentEvent {
  id              String              @id @default(uuid(7)) @db.Uuid
  providerEventId String              @unique @map("provider_event_id")
  /// The order named by `metadata.orderId`. Null when no such order exists.
  orderId         String?             @map("order_id") @db.Uuid
  type            String
  /// What receiving it did. `REFUND_DUE` rows are payments no order could use.
  outcome         PaymentEventOutcome
  /// The webhook body as received (after signature and schema checks).
  payload         Json
  receivedAt      DateTime            @map("received_at") @db.Timestamptz(3)

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  // Payments due a refund, oldest first.
  @@index([outcome, receivedAt])
  @@map("payment_events")
}
