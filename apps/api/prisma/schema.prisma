// TestTix database schema. Conventions:
// - Tables and columns are snake_case in Postgres (`@@map` / `@map`); models stay PascalCase/camelCase.
// - Primary keys are UUIDv7 (time-ordered, generated by Prisma), stored as `uuid`.
// - The connection URL lives in `prisma.config.ts`, not here (Prisma 7).
//
// After changing this file: `pnpm --filter @testtix/api db:migrate --name <change>`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // NodeNext resolution needs explicit `.js` extensions on relative imports.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Minimal placeholder proving the migration pipeline (C0.5). C1.2 adds the real columns.
model User {
  id    String @id @default(uuid(7)) @db.Uuid
  email String @unique

  @@map("users")
}
