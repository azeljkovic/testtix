{
  "name": "@testtix/api",
  "version": "0.0.0",
  "private": true,
  "description": "TestTix REST API (NestJS).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi": "node dist/openapi/export-openapi.js openapi.json",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "clean": "rm -rf dist src/generated .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.12",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-fastify": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "@testtix/shared": "workspace:*",
    "bullmq": "6.7.8",
    "fastify": "5.12.8",
    "handlebars": "4.7.10",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.2",
    "nestjs-zod": "5.6.0",
    "nodemailer": "10.5.0",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.11",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@testtix/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "jsqr": "1.4.0",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  }
}
