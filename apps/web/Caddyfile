# Caddy config of the web image (apps/web/Dockerfile): serves the built single-page app and puts
# the API replicas behind one address, as docker/compose.yml (`full` profile) runs them.
#
#   :8080  the web app, with the API under /api (prefix removed), like the Vite dev server
#   :3000  the API itself, for API clients and the payment provider's webhooks
#
# The API is the host `api`, port 3000: Caddy looks it up in DNS every few seconds and spreads
# requests over every address it has, one per replica of the compose `api` service.
{
	admin off
	# Plain HTTP: TLS is the job of whatever runs in front (the hosted demo's edge, docker/demo/).
	auto_https off
	servers {
		# Proxies in front whose X-Forwarded-For is kept (Caddy appends to it): none by default, so
		# Caddy replaces the header with the address it saw. The hosted demo sets `private_ranges`
		# for its edge Caddy, which writes the real client address there.
		trusted_proxies static {$TRUSTED_PROXIES}
	}
	# Logs as JSON lines on stdout, like the other services.
	log {
		output stdout
		format json
	}
}

# Security headers of the web app (C6.5). The build needs nothing but its own origin: no inline
# scripts or <style> elements (React sets style attributes through the DOM, which CSP allows), no
# fonts, images or calls elsewhere; checkout leaves for the payment page by navigation, which CSP
# doesn't restrict. HSTS is the hosted demo edge's job, since only it speaks HTTPS.
(security-headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
}

(api) {
	# Caddy replaces any X-Forwarded-For from an untrusted client with the address it saw (see
	# trusted_proxies above), so the API (TRUST_PROXY=true) counts rate limits per real client.
	reverse_proxy {
		dynamic a {
			name api
			port 3000
			refresh 5s
		}
		lb_policy round_robin
		# A replica that is restarting is skipped, and the request goes to another one.
		lb_try_duration 5s
		fail_duration 10s
	}
}

:8080 {
	encode zstd gzip
	root * /srv

	# The API's responses keep its own (stricter) security headers.
	handle_path /api/* {
		header -Server
		import api
	}

	# Built assets have content hashes in their names, so they never change. A missing one is a
	# 404, not the app's index.html.
	handle /assets/* {
		import security-headers
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		import security-headers
		header Cache-Control no-cache
		# Client-side routes (/events/…, /orders/…) all get the app's index.html.
		try_files {path} /index.html
		file_server
	}
}

:3000 {
	header -Server
	import api
}
