      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(testtix_http_requests_total{job=\"api\",route!~\"/health.*|/metrics\"}[1m]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
